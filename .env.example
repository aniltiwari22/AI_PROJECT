# Template only. Copy to .env and fill in real values there.
# .env is gitignored; THIS file is committed — never put real secrets here.

PORT=5000
# Origins allowed to call this API from a browser. '*' lets any website on
# the internet read responses using a logged-in user's session — never use
# it once this is reachable from anywhere. Comma-separated.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Ollama (chat model) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=180000
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=512
GROUNDED_NUM_PREDICT=640
OLLAMA_NUM_CTX=1024
# Leave blank: benchmarked 3.5 tok/s on all 8 logical threads vs 2.3 tok/s
# pinned to 4 physical cores, so restricting threads is slower here.
OLLAMA_NUM_THREAD=

# --- Internal knowledge base ---
# Embedding model for semantic search. If it is not pulled, retrieval falls
# back to keyword matching automatically.  ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
KNOWLEDGE_FILE=storage/knowledge.json
KNOWLEDGE_CHUNK_WORDS=180
KNOWLEDGE_CHUNK_OVERLAP=30

# Minimum score for internal data to answer without escalating to the web.
# Embedding scores (cosine) and keyword scores (hit ratio) are not comparable,
# so each mode has its own threshold.
RELEVANCE_THRESHOLD_EMBEDDING=0.62
RELEVANCE_THRESHOLD_LEXICAL=0.5

# --- File uploads (PDF / images / documents) ---
# Images are read by a multimodal model. On CPU this is slow (~2-5 min), so the
# timeout is generous. A GPU makes this dramatically faster.
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Unload the vision model immediately after use. This machine cannot hold
# both 7B models at once (10.7GB of 16.9GB) and keeping it resident forces
# the chat model into swap, making every reply far slower.
VISION_KEEP_ALIVE=0
VISION_TIMEOUT_MS=600000
VISION_NUM_PREDICT=600
UPLOAD_MAX_BYTES=20971520
JSON_BODY_LIMIT=30mb
# Long documents are excerpted to the passages matching your question.
FILE_CONTEXT_CHARS=4000

# --- Web search fallback (Tavily) ---
# Free key from https://tavily.com — leave blank to disable web fallback.
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_MS=20000
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_CONTENT_CHARS=1200

# --- Storage ---
# Chat logs, uploaded files, the knowledge base, the semantic cache and
# both request logs all live in this one SQLite database.
# The DB_FILE / KNOWLEDGE_FILE / CACHE_FILE settings below are now only
# read by src/storage/migrate.js, which imports the old JSON files once.
SQLITE_FILE=storage/ashu.db

DB_FILE=storage/database.json

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:5000/api/v1

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_MAX_HISTORY_TURNS=8

# No longer used by the chat pipeline; the built-in local store replaced it.

# --- v1.0.1: Excel knowledge, cache and logging ---
# Curated rows answered straight from the workbook, no LLM call (~1ms).
KNOWLEDGE_XLSX=storage/knowledge.xlsx
EXCEL_MATCH_THRESHOLD=0.6
# Semantic cache. 0.95 matches near-identical repeats only; measured on this
# setup a genuine paraphrase scores ~0.85, so lowering it risks false hits.
CACHE_FILE=storage/cache.json
CACHE_SIMILARITY=0.95
CACHE_MAX_ENTRIES=500
# Per-request Excel log, one sheet per month, created automatically.
LOG_XLSX=logs/AssistantLogs.xlsx
EXCEL_LOGGING=true

# Repository indexing. Read-only: the assistant walks and reads a folder and
# never writes to it. Caps exist because embedding runs at roughly 20 files a
# minute on CPU, so an unbounded folder means an unbounded wait.
REPO_MAX_FILES=400
REPO_MAX_FILE_BYTES=262144
# Chars per code chunk. Code is split on declaration boundaries, not word
# windows, so this is an upper bound rather than a fixed size.
KNOWLEDGE_CODE_CHUNK_CHARS=1400

# Telegram is a second way in and does NOT pass through the HTTP auth
# middleware. Empty means the bot answers nobody. Message the bot once and
# the server logs your chat id, then paste it here (comma-separated).
TELEGRAM_ALLOWED_CHAT_IDS=

# Set only when a reverse proxy or tunnel is in front (e.g. '1' for one hop).
# Needed so the login lockout counts per client rather than per proxy.
TRUST_PROXY=

# Hybrid retrieval. Vector and keyword search both run, and their ranks are
# fused with Reciprocal Rank Fusion — cosine (0..1) and BM25 (negative,
# unbounded) cannot be compared directly, so only the ranks are used.
RETRIEVAL_RRF_K=60
# How deep each retriever goes before fusing. Wider than topK so a chunk
# ranked 8th by one and 3rd by the other can still win.
RETRIEVAL_FUSION_DEPTH=20
RELEVANCE_THRESHOLD_HYBRID=0.58
# Neighbouring chunks pulled in around the best match. Bounded because
# prompt evaluation is the expensive part of a request.
INTERNAL_CONTEXT_CHARS=3000
# A chunk both retrievers found is stronger evidence than one either found
# alone. Capped so agreement between two weak signals cannot manufacture
# confidence.
RETRIEVAL_AGREEMENT_BONUS=0.05

# Texts per embedding request. Batching saves HTTP round trips but not model
# time — measured at 0.96x on realistic 1200-character chunks, where the
# forward passes dominate. Kept because fewer round trips is cleaner, not
# because it is faster.
EMBED_BATCH_SIZE=32
