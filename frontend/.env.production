# Production builds call the API on the same origin that served the page.
#
# This lives in a file rather than being passed on the command line because
# Git Bash rewrites a leading slash into a Windows path: setting
# VITE_API_BASE_URL=/api/v1 there baked
# "C:/Users/.../Programs/Git/api/v1" into the bundle, and every request became
# a blocked file:// URL. Vite reads this file directly, so no shell can touch
# it.
#
# Same origin also means CORS never applies, and there is no second host to
# configure per deployment.
VITE_API_BASE_URL=/api/v1
